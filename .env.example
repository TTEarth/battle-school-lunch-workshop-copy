# NEIS Open API 설정 (값은 채우지 말고 이름만 참고)
NEIS_BASE_URL=
NEIS_API_KEY=
NEIS_TIMEOUT_SECONDS=

# MCP 서버 설정 (기본값: 0.0.0.0:8001)
MCP_HOST=
MCP_PORT=

# 멀티에이전트 서버 설정 (기본값: 0.0.0.0:8002)
AGENT_HOST=
AGENT_PORT=
# 에이전트가 급식 데이터를 조회할 MCP 엔드포인트 (기본값: http://localhost:8001/mcp)
MCP_URL=
# LLM 백엔드: copilot(GitHub Copilot SDK, Copilot CLI 필요) 또는 github-models
AGENT_LLM_BACKEND=
# github-models 백엔드용 토큰과 모델
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=
# copilot 백엔드용 모델(비우면 기본 모델)
GITHUB_COPILOT_MODEL=
